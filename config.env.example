# AccoFIL NCUpload – példa, valódi titkos adat nélkül.
# A telepítő minden mezőt bekér; később: ncupload --configure
# USER helyére a saját Linux-felhasználó kerül. Ezt a fájlt ne source-old.
# Egyedi config: az indító automatikusan beállítja a NCORE_CONFIG változót.
# A heti jelölő a telepítőnek szól; a futó timert systemctl kezeli.

NCORE_VENV="/home/USER/.local/share/ncore-up/venv"
NCORE_BIN_DIR="/home/USER/.local/bin"
NCORE_NCUP_DIR="/home/USER/storage/NCUP"
NCORE_COOKIES="/home/USER/.config/ncore-up/cookies.txt"
NCORE_LOG_DIR="/home/USER/logs/ncore-up"
NCORE_WORK_DIR="/home/USER/.cache/ncore-up"
NCORE_MKBRR="/home/USER/.local/share/ncore-up/bin/mkbrr"
NCORE_BDINFO="/home/USER/.local/share/ncore-up/bin/bdinfo"
NCORE_QB_CATEGORY=""
NCORE_REFRESH_WEEKLY="yes"
QB_URL="http://127.0.0.1:8080"
QB_USER=""
QB_PASS=""
DEEPL_KEY=""
IGDB_CLIENT_ID=""
IGDB_CLIENT_SECRET=""
GOOGLE_BOOKS_KEY=""
DISCOGS_TOKEN=""
DISCOGS_CONSUMER_KEY=""
DISCOGS_CONSUMER_SECRET=""
ACOUSTID_KEY=""
COMICVINE_KEY=""
SETLISTFM_KEY=""
LASTFM_KEY=""
TVDB_KEY=""
FANART_KEY=""
SPOTIFY_CLIENT_ID=""
SPOTIFY_CLIENT_SECRET=""
GITHUB_TOKEN=""
TMDB_API=""
